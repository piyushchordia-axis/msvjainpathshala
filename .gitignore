# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# env
.env
.env.local

# uploaded files (local-disk storage provider)
uploads/
apps/api-server/uploads/

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Build caches & generated artifacts — never commit (regenerable)
/.pnpm-store/
/.turbo/
.turbo/
/.agent-runner/

# Python virtualenvs & bytecode
.venv/
__pycache__/
*.pyc

# Terraform local cache & state (provider binaries are huge; state is sensitive)
.terraform/
*.tfstate
*.tfstate.*

# Local scratch / debug artifacts
infra/scratch/
