{
  "title": "Business Metrics",
  "uid": "jp-business-metrics",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "tags": ["jp", "production", "step23"],
  "timezone": "Asia/Kolkata",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "DAU",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": "prometheus",
      "targets": [{ "expr": "count(count by (user_id) (api_request_total{service=\"api\"}[1d]))" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Attendance check-ins / hour",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": "prometheus",
      "targets": [{ "expr": "sum(rate(attendance_marks_total[1h])) * 3600" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Punya awards / minute",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": "prometheus",
      "targets": [{ "expr": "sum(rate(punya_transactions_total{kind=\"award\"}[5m])) * 60" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Notifications sent / hour",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": "prometheus",
      "targets": [{ "expr": "sum(rate(notification_send_total{result=\"ok\"}[1h])) * 3600" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Active students by city (7d)",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 10 },
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "active_students_by_city{service=\"api\"}",
          "legendFormat": "{{city}}"
        }
      ]
    }
  ]
}
