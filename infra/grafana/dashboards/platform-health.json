{
  "title": "Platform Health",
  "uid": "jp-platform-health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["jp", "production", "step23"],
  "timezone": "Asia/Kolkata",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API p50 / p95 / p99 latency (ms)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_ms_bucket{service=\"api\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_ms_bucket{service=\"api\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_ms_bucket{service=\"api\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RPS by route",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"api\"}[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate (5xx %)",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"api\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"api\"}[5m])) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "ALB healthy targets",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 },
      "datasource": "cloudwatch",
      "targets": [
        {
          "namespace": "AWS/ApplicationELB",
          "metricName": "HealthyHostCount",
          "statistic": "Minimum"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "OTP send success rate (%)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 4 },
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "100 * (sum(rate(otp_send_total{result=\"ok\"}[5m])) / sum(rate(otp_send_total[5m])))"
        }
      ]
    }
  ]
}
