# Optional hoists for Metro / native tooling. SDK 54+ monorepo resolution does not
# require disableHierarchicalLookup; keep these patterns for predictable RN/Expo paths.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=@react-navigation/*
public-hoist-pattern[]=expo-modules-core
