{
  "title": "Database",
  "uid": "jp-database",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["jp", "production", "step23"],
  "timezone": "Asia/Kolkata",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Connection pool usage",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "prometheus",
      "targets": [
        { "expr": "pg_pool_in_use{service=\"api\"}", "legendFormat": "in use" },
        { "expr": "pg_pool_idle{service=\"api\"}", "legendFormat": "idle" },
        { "expr": "pg_pool_max{service=\"api\"}", "legendFormat": "max" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Slow queries (> 1s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "loki",
      "targets": [{ "expr": "{service=\"api\"} |= \"slow_query\" | logfmt | duration_ms > 1000" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Replication lag (ms)",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "datasource": "cloudwatch",
      "targets": [
        {
          "namespace": "AWS/RDS",
          "metricName": "ReplicaLag",
          "statistic": "Maximum"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "RDS CPU",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 },
      "datasource": "cloudwatch",
      "targets": [
        {
          "namespace": "AWS/RDS",
          "metricName": "CPUUtilization",
          "statistic": "Average"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 70, "color": "yellow" },
              { "value": 90, "color": "red" }
            ]
          }
        }
      }
    }
  ]
}
