{
  "title": "Queue Status",
  "uid": "jp-queue-status",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["jp", "production", "step23"],
  "timezone": "Asia/Kolkata",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Waiting count per queue",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "bullmq_waiting_count{job=\"jp-queue-metrics\"}",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DLQ depth per queue",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "bullmq_dlq_count{job=\"jp-queue-metrics\"}",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Processing rate (jobs/min)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "rate(bullmq_completed_total[5m]) * 60",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed last 1h",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 4 },
      "datasource": "prometheus",
      "targets": [{ "expr": "sum(increase(bullmq_failed_total[1h]))" }]
    }
  ]
}
