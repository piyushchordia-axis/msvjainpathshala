# ---------------------------------------------------------------------------
# Jain Pathshala — root .env.example
# Copy to .env at the corresponding workspace and fill values for local dev.
# Per-app .env.example files (apps/api/.env.example, apps/web/.env.example,
# apps/mobile/.env.example, apps/ai/.env.example) override this for their own
# scopes; this root file documents the common variables used across the stack.
# ---------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
TZ=Asia/Kolkata

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgres://jp:jp_dev_pwd@localhost:5432/jainpathshala
DATABASE_URL_READ=

# --- Redis 7 ---
REDIS_URL=redis://localhost:6379

# --- Storage (MinIO in dev, R2 / S3 in prod) ---
STORAGE_DRIVER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_REGION=ap-south-1
STORAGE_BUCKET_PRIVATE=jp-dev-media-private
STORAGE_BUCKET_PUBLIC=jp-dev-media-public
STORAGE_BUCKET_EXPORTS=jp-dev-exports
STORAGE_BUCKET_RECEIPTS=jp-dev-receipts

# --- Email (MailHog in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Auth (RS256) ---
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_PREVIOUS_PUBLIC_KEY_PEM=

# --- External services (set real values in non-dev) ---
MSG91_AUTH_KEY=
FCM_SERVICE_ACCOUNT_JSON=
RESEND_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
OPENAI_API_KEY=

# --- AI service ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_HMAC_SECRET=
AI_SERVICE_IP_ALLOWLIST=

# --- Feature flags ---
AI_MODERATION_ENABLED=false
EIGHTY_G_ENABLED=false
SMS_MONTHLY_CAP_INR=
