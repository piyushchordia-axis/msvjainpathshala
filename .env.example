# Copy to .env and set your local Postgres password
DATABASE_URL=postgres://jp:jp_dev_pwd@localhost:5434/jainpathshala
JP_AUTH_SECRET=jp-dev-secret-do-not-use-in-production
LOG_LEVEL=info
NODE_ENV=development

