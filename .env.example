# Copy to .env and set your local Postgres password
DATABASE_URL=postgres://jp:jp_dev_pwd@localhost:5434/jainpathshala
# REQUIRED in production: a strong random value (e.g. `openssl rand -base64 48`),
# injected via your platform's secrets manager and NEVER committed. The dev value
# below is only a placeholder for local development; the server fails fast at
# startup if JP_AUTH_SECRET is unset when NODE_ENV=production.
JP_AUTH_SECRET=jp-dev-secret-do-not-use-in-production
LOG_LEVEL=info
NODE_ENV=development

# Mobile (Expo Go on a physical phone): use your PC's LAN IP, NOT localhost
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.6:8080
# Simulator / web only:
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
