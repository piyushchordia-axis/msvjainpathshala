{
  "name": "@jp/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Jain Pathshala — EN/HI translation files and t() / tBilingual() helpers.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./locales/en.json": "./src/locales/en.json",
    "./locales/hi.json": "./src/locales/hi.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --target es2022",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "clean": "rm -rf dist .turbo"
  }
}
