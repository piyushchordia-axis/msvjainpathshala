# Jain Pathshala API — production env. Copy to .env and fill in.
# (gitignored / never committed.)

# ───────────────── Required ─────────────────
NODE_ENV=production

# Host Postgres + Redis (with `network_mode: host`, localhost is the host machine).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/jainpathshala
# REQUIRED in production. Without Redis, BullMQ debounce collapses to inline
# execution in the HTTP request path (quadratic in marks per session).
REDIS_URL=redis://localhost:6379

# Postgres pool sizing (PERF #3). Set relative to Postgres max_connections,
# divided across API + worker instances. Example: max_connections=100 → leave
# ~20 for superuser/admin tools, then split the rest (e.g. 40 API / 40 worker
# across replicas). Defaults: PG_POOL_MAX=20, PG_WORKER_POOL_MAX=5.
# PG_POOL_MAX=20
# PG_WORKER_POOL_MAX=5
# PROCESS_ROLE=api

# PERF #15 — process split. Production: run `pnpm start` (API) and
# `pnpm start:worker` (BullMQ + crons) as separate processes / compose services.
# Single-container / local escape hatch — also runs workers+crons inside the API:
# RUN_WORKERS_INLINE=1
# PROCESS_ROLE is set by docker-compose (api vs worker); do not set PROCESS_ROLE=worker
# on the API entry or it will refuse to start.

# PERF #19 — optional shared secret for scraping /metrics from non-loopback hosts.
# Loopback scrapes (127.0.0.1) are always allowed. Do not expose /metrics publicly.
# METRICS_TOKEN=

# HMAC secret for auth tokens, signed QR, and signed upload URLs.
# Generate: openssl rand -base64 48
JP_AUTH_SECRET=

# Public base URL of this API (used to build /uploads links + absolute URLs).
# Must match the mobile app's EXPO_PUBLIC_API_BASE_URL and your nginx server_name.
PUBLIC_API_URL=https://jainpathshala.enaacreations.com

# Payments — REQUIRED in production (the server refuses to start without these).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS OTP — mint + verify locally (argon2id, 5-min TTL, max 5 attempts).
# OTP_ENABLED=true  → deliver via 2Factor (needs keys below).
# OTP_ENABLED=false → DEFAULT_OTP for every phone, skip SMS (local / UAT).
# DEFAULT_OTP_FLAG=true  (with SMS on) → send DEFAULT_OTP in the SMS.
# DEFAULT_OTP_FLAG=false (with SMS on) → send a freshly generated code.
# Unset OTP_ENABLED defaults to false. Unset DEFAULT_OTP_FLAG defaults to false.
OTP_ENABLED=false
DEFAULT_OTP_FLAG=false
DEFAULT_OTP=123456
# 2Factor.in is delivery-only — do NOT use their AUTOGEN/VERIFY session flow.
# GET https://2factor.in/API/V1/{KEY}/SMS/{PHONE}/{OTP}/{TEMPLATE}
# GOTCHA: HTTP 200 can still mean failure — Status must be "Success".
TWO_FACTOR_API_KEY=
# DLT-approved template name registered in the 2Factor dashboard (not a numeric
# DLT id). Required whenever TWO_FACTOR_API_KEY is set.
TWO_FACTOR_TEMPLATE=oceanlogin
# Alternatives (pick one): SMS_PROVIDER=msg91 with MSG91_AUTH_KEY +
# MSG91_TEMPLATE_ID (+ optional MSG91_SENDER_ID), or SMS_PROVIDER=generic with
# SMS_API_URL (+ optional SMS_API_KEY) for any JSON {phone, code} endpoint.

# ───────────────── Store review ─────────────────
# Test numbers for App Store / Play reviewers, the same mechanism Firebase Auth
# calls "phone numbers for testing". Listed numbers accept the fixed code and
# never receive an SMS; every other number always gets a real one. Honoured in
# production on purpose — review happens against production — so it is scoped by
# an explicit allow-list, not by NODE_ENV.
# Nominate a LOW-PRIVILEGE demo account, and unset this once review is done
# (the server logs a warning at every startup while it is populated).
# Format: +E164:code, comma-separated.
# OTP_TEST_NUMBERS=+919800000007:246813

# ───────────────── Recommended ─────────────────
# Allow-list of browser origins for the admin web app (comma-separated).
# The native mobile app sends no Origin and is always allowed — leave blank if
# you don't host the web admin yet.
CORS_ORIGINS=

# ───────────────── Optional (sensible defaults) ─────────────────
# PORT / HOST / UPLOADS_DIR are set by docker-compose; override only if needed.
# UPLOAD_URL_TTL_SECONDS=3600
# ACCESS_TOKEN_TTL_SECONDS=900
# LOG_LEVEL=info

# Reviewed Hindi suggestions for notice composition (POST /v1/translate).
# Default 'none' — UI hides the button; nothing breaks in dev/CI without a key.
# TRANSLATION_PROVIDER=none
# TRANSLATION_PROVIDER=openai
# TRANSLATION_PROVIDER=anthropic
# TRANSLATION_API_KEY=
# TRANSLATION_MODEL=

# File storage — default is local disk (persisted to the jp_uploads volume in compose).
# Switch provider with STORAGE_PROVIDER only; R2 and AWS S3 share the same S3-compatible client.
#
# Local (default):
# STORAGE_PROVIDER=local
#
# Cloudflare R2:
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev   # optional; direct public assets only
#
# AWS S3 (or unified names for any provider):
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=your-bucket
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=ap-south-1
#
# MinIO / custom S3-compatible endpoint:
# STORAGE_PROVIDER=minio
# STORAGE_BUCKET=dev
# STORAGE_ACCESS_KEY_ID=minio
# STORAGE_SECRET_ACCESS_KEY=minio123
# STORAGE_ENDPOINT=http://127.0.0.1:9000
#
# Legacy aliases still work: S3_BUCKET, S3_ENDPOINT, AWS_* map into the same config.
# UPLOAD_URL_TTL_SECONDS=3600

# Library audio transcode (MP3 → 128kbps mono). Required for admin audio upload.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
