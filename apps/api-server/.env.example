# Jain Pathshala API — production env. Copy to .env and fill in.
# (gitignored / never committed.)

# ───────────────── Required ─────────────────
NODE_ENV=production

# Host Postgres + Redis (with `network_mode: host`, localhost is the host machine).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/jainpathshala
REDIS_URL=redis://localhost:6379

# HMAC secret for auth tokens, signed QR, and signed upload URLs.
# Generate: openssl rand -base64 48
JP_AUTH_SECRET=

# Public base URL of this API (used to build /uploads links + absolute URLs).
# Must match the mobile app's EXPO_PUBLIC_API_BASE_URL and your nginx server_name.
PUBLIC_API_URL=https://jainpathshala.enaacreations.com

# Payments — REQUIRED in production (the server refuses to start without these).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ───────────────── Recommended ─────────────────
# Allow-list of browser origins for the admin web app (comma-separated).
# The native mobile app sends no Origin and is always allowed — leave blank if
# you don't host the web admin yet.
CORS_ORIGINS=

# ───────────────── Optional (sensible defaults) ─────────────────
# PORT / HOST / UPLOADS_DIR are set by docker-compose; override only if needed.
# UPLOAD_URL_TTL_SECONDS=3600
# ACCESS_TOKEN_TTL_SECONDS=900
# LOG_LEVEL=info

# File storage: default is local disk (persisted to the jp_uploads volume).
# For multi-instance/autoscale, switch to S3 instead:
# S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
