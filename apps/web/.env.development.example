# Copy to `.env.development` before running `pnpm --filter @jp/web dev`.
# - INTERNAL_API_BASE_URL: server-side base URL for the NestJS backend
#   (Route Handlers + Server Components use this).
# - NEXT_INTERNAL_API_BASE_URL: same value, exposed through next.config.ts
#   to environment-readable code (kept in sync by Next.js).
INTERNAL_API_BASE_URL=http://localhost:3000
NEXT_INTERNAL_API_BASE_URL=http://localhost:3000
