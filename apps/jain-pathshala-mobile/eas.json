{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      }
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "22.22.1",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://jainpathshala.enaacreations.com"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "node": "22.22.1",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://jainpathshala.enaacreations.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6782585282",
        "ascApiKeyPath": "./credentials/AuthKey_75JR6GG22Q.p8",
        "ascApiKeyId": "75JR6GG22Q",
        "ascApiKeyIssuerId": "20f04c20-2b8f-4482-a782-f201f84c8ca5"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/play-service-account.json",
        "track": "alpha"
      }
    }
  }
}
