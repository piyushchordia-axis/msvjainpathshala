# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native prebuild output (anchored to app root so it doesn't match
# fastlane/metadata/android/ etc.)
/ios/
/android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Signing / submit credentials (ASC API key, Play service account, etc.)
credentials/

# fastlane generated artifacts (keep metadata/ + screenshots/ committed)
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/*.log

# EAS local build outputs (large binaries — never commit)
*.aab
*.apk
build-*.aab
build-*.apk

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
dev-qr.html

# typescript
*.tsbuildinfo
.vercel

.env
