# Copy to .env in this folder (optional overrides).

#

# Default `pnpm run dev` uses Metro on :8081 and proxies /api + /v1 to api-server :8080

# (works when Windows firewall blocks inbound :8080 on Public Wi‑Fi).

#

# Direct LAN to api-server (after scripts/setup-dev-network.ps1 as Administrator):

# EXPO_USE_LAN_API=1

# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.6:8080

#

# Android emulator only:

# EXPO_ANDROID_EMULATOR=1

# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080



