{
  "expo": {
    "name": "Jain Pathshala Mobile",
    "slug": "jain-pathshala-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jain-pathshala-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.jainpathshala.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": false
        },
        "NSLocalNetworkUsageDescription": "Jain Pathshala connects to your development server on the same Wi‑Fi network to sign in and load your data.",
        "NSBonjourServices": ["_expo._tcp"]
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "package": "org.jainpathshala.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Jain Pathshala uses the camera to scan students' ID-card QR codes for shivir attendance."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Jain Pathshala uses your location to verify you are at the centre when marking class attendance.",
          "locationWhenInUsePermission": "Jain Pathshala uses your location to verify you are at the centre when marking class attendance.",
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
