{
  "name": "@jp/api",
  "version": "0.0.0",
  "private": true,
  "description": "Jain Pathshala — NestJS backend (HTTP + BullMQ worker).",
  "scripts": {
    "build:deps": "pnpm --filter @jp/shared --filter @jp/i18n --filter @jp/design-tokens build",
    "build": "pnpm run build:deps && tsc -p tsconfig.build.json",
    "dev": "pnpm run build:deps && node --env-file=.env.development -r @swc-node/register src/main.ts",
    "dev:worker": "pnpm run build:deps && node --env-file=.env.development -r @swc-node/register src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test": "echo \"@jp/api: tests land in Step 5+\" && exit 0",
    "test:integration": "echo \"@jp/api: integration tests land in Step 5+\" && exit 0",
    "db:generate": "tsx --env-file=.env.development node_modules/drizzle-kit/bin.cjs generate --config drizzle.config.ts",
    "db:migrate": "tsx --env-file=.env.development src/db/migrate.ts",
    "db:studio": "tsx --env-file=.env.development node_modules/drizzle-kit/bin.cjs studio --config drizzle.config.ts",
    "db:seed:dev": "echo \"db:seed:dev lands in Step 4\" && exit 0",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@jp/i18n": "workspace:*",
    "@jp/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/terminus": "^10.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@sentry/node": "^8.47.0",
    "bullmq": "^5.34.5",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.10",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2"
  }
}
