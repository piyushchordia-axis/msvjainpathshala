# ---------------------------------------------------------------------------
# Jain Pathshala — apps/api local development env.
#
# This file is loaded by ConfigModule when NODE_ENV=development. It assumes
# infra/docker/docker-compose.yml is up; if you are running Postgres / Redis
# natively (Homebrew etc.), the localhost values still work — only the user /
# password / port need to match.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
WORKER_HEALTH_PORT=3100
LOG_LEVEL=debug
TZ=Asia/Kolkata
APP_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3001

# Database — local Postgres. Pick whichever connection your dev box uses:
#   docker-compose:  postgres://jp:jp_dev_pwd@localhost:5432/jainpathshala
#   Homebrew:        postgres://${USER}@localhost:5432/jainpathshala  (no password)
DATABASE_URL=postgres://sumit@localhost:5432/jainpathshala
DATABASE_URL_READ=
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=2
DATABASE_SSL=false

# Redis — local
REDIS_URL=redis://localhost:6379
REDIS_TLS=false
REDIS_KEY_PREFIX=jp:dev:

# JWT — empty in dev (Step 5 wires real keys + rotation).
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_PREV_PUBLIC_KEY_PEM=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=jainpathshala.local
JWT_AUDIENCE=jp.api

# OTP
OTP_TTL_SECONDS=300
OTP_REQUEST_LIMIT_PER_HOUR=10
OTP_REQUEST_LIMIT_PER_DAY=30
OTP_MAX_VERIFY_ATTEMPTS=5

# Dev-only master OTP. Honoured ONLY when NODE_ENV=development.
# Any phone can verify with this code so you don't have to scrape logs.
# Comment out (or set empty) to require real OTPs even in dev.
JP_DEV_MASTER_OTP=000000

# Storage — `noop` driver skips the /readyz S3 check in dev. Switch to `minio`
# once you bring up infra/docker/docker-compose.yml.
STORAGE_DRIVER=minio
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_PRIVATE=jp-dev-media-private
S3_BUCKET_PUBLIC=jp-dev-media-public
S3_BUCKET_EXPORTS=jp-dev-exports
S3_BUCKET_RECEIPTS=jp-dev-receipts
S3_CDN_PRIVATE=http://localhost:9000/jp-dev-media-private
S3_CDN_PUBLIC=http://localhost:9000/jp-dev-media-public
SIGNED_URL_TTL_SECONDS=3600

# External integrations — empty in dev; Step 5+ adds local stubs.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_BATCH_SIZE=500
MSG91_AUTH_KEY=
MSG91_SENDER_ID=JPMSV
MSG91_OTP_TEMPLATE_ID=
MSG91_NOTICE_TEMPLATE_ID=
MSG91_DLT_ENTITY_ID=
RESEND_API_KEY=
RESEND_FROM=Jain Pathshala <dev@jainpathshala.local>

# AI service
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_HMAC_SECRET=dev-only-not-secret
AI_SERVICE_TIMEOUT_MS=30000

# Observability — disabled in dev (Pino still emits trace/span ids).
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=jp-api-dev

# Rate limiting
RATE_LIMIT_ANON_PER_MIN=60
RATE_LIMIT_AUTH_READ_PER_MIN=300
RATE_LIMIT_AUTH_WRITE_PER_MIN=60

# Feature flags
FEATURE_AI_QUIZ_GENERATION=true
FEATURE_VIRUS_SCANNING=false
FEATURE_LIVE_SHIVIR_WS=true
FEATURE_SCHEDULED_EXAMS=true

# CORS — permissive in dev for local mobile + web testing
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:19006,http://localhost:19000

# /metrics scrape access
METRICS_INTERNAL_KEY=

# Worker
WORKER_KIND=all
WORKER_CONCURRENCY_OVERRIDE=
