# ---------------------------------------------------------------------------
# Jain Pathshala — apps/api environment variables.
#
# Source of truth: SPEC.md §14.1 (backend) + §14.2 (worker additions).
# Validated at startup by src/core/config/env.schema.ts — the app FAILS FAST
# on missing required vars (no silent defaults for security-sensitive fields).
# ---------------------------------------------------------------------------

# ===== Runtime =============================================================
NODE_ENV=production                                # development | staging | production | test
PORT=3000                                          # HTTP port for src/main.ts
WORKER_HEALTH_PORT=3100                            # Health port for src/worker.ts (SPEC §18.6)
LOG_LEVEL=info                                     # trace | debug | info | warn | error | fatal
TZ=Asia/Kolkata                                    # All cron jobs run in IST (CLAUDE.md)
APP_BASE_URL=https://api.jainpathshala.org
WEB_BASE_URL=https://www.jainpathshala.org

# ===== Database — PostgreSQL 16 (RDS in prod) =============================
# Required.
DATABASE_URL=postgres://jp_app:****@jp-prod-rds:5432/jainpathshala
# Optional read replica (SPEC §17.1). If unset, dbRead falls back to the write pool.
DATABASE_URL_READ=postgres://jp_read:****@jp-prod-rds-ro:5432/jainpathshala
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=2
DATABASE_SSL=true                                  # rejectUnauthorized=true in prod

# ===== Redis 7 (ElastiCache in prod) ======================================
# Required. Used by cache / OTP / rate-limit / BullMQ / pub-sub / Socket.IO.
REDIS_URL=rediss://:****@jp-prod-redis:6379
REDIS_TLS=true
REDIS_KEY_PREFIX=jp:prod:                          # All keys namespaced (avoids cross-tenant leakage)

# ===== Auth — JWT (RS256, keys in Secrets Manager) ========================
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_PREV_PUBLIC_KEY_PEM=                           # Rotation grace window
JWT_ACCESS_TTL_SECONDS=900                         # 15 minutes
JWT_REFRESH_TTL_SECONDS=2592000                    # 30 days
JWT_ISSUER=jainpathshala.org
JWT_AUDIENCE=jp.api

# ===== OTP =================================================================
OTP_TTL_SECONDS=300                                # 5 minutes
OTP_REQUEST_LIMIT_PER_HOUR=10
OTP_REQUEST_LIMIT_PER_DAY=30
OTP_MAX_VERIFY_ATTEMPTS=5
# Dev-only: when set AND NODE_ENV=development, any phone can verify with
# this code. Must be 6 digits. Leave empty in staging/prod — OtpService
# also checks NODE_ENV before honouring it, so a leaked env var alone
# can't unlock the back door.
JP_DEV_MASTER_OTP=

# ===== Storage — S3 / R2 (MinIO in dev) ===================================
# STORAGE_DRIVER=noop is allowed in dev and skips the readyz S3 check.
STORAGE_DRIVER=r2                                  # noop | minio | r2 | s3
S3_REGION=auto
S3_ENDPOINT=https://****.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PRIVATE=jp-prod-media-private
S3_BUCKET_PUBLIC=jp-prod-media-public
S3_BUCKET_EXPORTS=jp-prod-exports
S3_BUCKET_RECEIPTS=jp-prod-receipts
S3_CDN_PRIVATE=https://cdn-priv.jainpathshala.org
S3_CDN_PUBLIC=https://cdn.jainpathshala.org
SIGNED_URL_TTL_SECONDS=3600

# ===== Razorpay (payments + webhooks) =====================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ===== Firebase FCM (push) ================================================
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=                          # Full JSON blob
FCM_BATCH_SIZE=500

# ===== MSG91 SMS ===========================================================
MSG91_AUTH_KEY=
MSG91_SENDER_ID=JPMSV
MSG91_OTP_TEMPLATE_ID=
MSG91_NOTICE_TEMPLATE_ID=
MSG91_DLT_ENTITY_ID=

# ===== Resend (email) =====================================================
RESEND_API_KEY=
RESEND_FROM=Jain Pathshala <noreply@jainpathshala.org>

# ===== AI service (FastAPI) ===============================================
AI_SERVICE_BASE_URL=https://ai.internal.jainpathshala.org
AI_SERVICE_HMAC_SECRET=
AI_SERVICE_TIMEOUT_MS=30000

# ===== Observability =======================================================
SENTRY_DSN=                                        # Empty disables Sentry (dev default)
OTEL_EXPORTER_OTLP_ENDPOINT=                       # Empty disables OTel export (still emits ids)
OTEL_SERVICE_NAME=jp-api

# ===== Rate limiting =======================================================
RATE_LIMIT_ANON_PER_MIN=60
RATE_LIMIT_AUTH_READ_PER_MIN=300
RATE_LIMIT_AUTH_WRITE_PER_MIN=60

# ===== Feature flags =======================================================
FEATURE_AI_QUIZ_GENERATION=true
FEATURE_VIRUS_SCANNING=false
FEATURE_LIVE_SHIVIR_WS=true
FEATURE_SCHEDULED_EXAMS=true

# ===== CORS ================================================================
CORS_ALLOWED_ORIGINS=https://www.jainpathshala.org,https://admin.jainpathshala.org

# ===== /metrics access (SPEC §18.6) =======================================
# Loopback ips are always allowed. Set this to enable scrape from a sidecar IP
# inside the ECS task — empty disables non-loopback scraping.
METRICS_INTERNAL_KEY=

# ===== Worker (§14.2) ======================================================
WORKER_KIND=all                                    # all | notifications | media | reports | analytics
WORKER_CONCURRENCY_OVERRIDE=                       # blank = use per-queue defaults
