# Copy to `.env.development` (and any other Expo env-mode files you need)
# before running `pnpm dev`. Expo inlines `EXPO_PUBLIC_*` at bundle time.

# Local backend (default for iOS Simulator + physical-device-on-Wi-Fi).
# For Android emulator use http://10.0.2.2:3000 (the emulator's loopback
# alias for your Mac/PC host).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional: surface env name on splash / settings.
EXPO_PUBLIC_APP_ENV=development
