{
  "name": "@jp/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Jain Pathshala — Expo React Native mobile app (parents, students, shikshaks, sanchalaks, admins).",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:tunnel": "node scripts/dev-tunnel.mjs",
    "dev:tunnel:clean": "node scripts/clear-metro-cache.mjs && EXPO_METRO_CLEAR=1 node scripts/dev-tunnel.mjs",
    "metro:clear-cache": "node scripts/clear-metro-cache.mjs",
    "dev:lan": "expo start --lan",
    "expo:write-dev-json": "node scripts/write-expo-dev-json.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "smoke:auth": "node scripts/smoke-auth.mjs"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@expo/metro-runtime": "~6.1.2",
    "@expo-google-fonts/jetbrains-mono": "^0.2.3",
    "@expo-google-fonts/mukta": "^0.2.3",
    "@expo-google-fonts/tiro-devanagari-sanskrit": "^0.2.3",
    "@jp/design-tokens": "workspace:*",
    "@jp/i18n": "workspace:*",
    "@jp/shared": "workspace:*",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@tanstack/query-async-storage-persister": "^5.62.7",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-query-persist-client": "^5.62.7",
    "axios": "^1.7.9",
    "expo": "~54.0.13",
    "expo-application": "~7.0.7",
    "expo-blur": "~15.0.7",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.9",
    "expo-device": "~8.0.9",
    "expo-file-system": "~19.0.16",
    "expo-font": "~14.0.8",
    "expo-image": "~3.0.10",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-location": "~19.0.7",
    "expo-router": "~6.0.12",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.7",
    "i18next": "^24.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.2.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "~3.3.3",
    "react-native-reanimated": "~4.1.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.1",
    "ulid": "^2.3.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "detox": "^20.30.0",
    "jest": "^29.7.0",
    "typescript": "^5.7.2"
  },
  "detox": {
    "configurations": "./.detoxrc.js"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/react"
      ]
    }
  }
}
