{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "android": { "buildType": "apk" },
      "env": {
        "JP_API_BASE_URL": "http://localhost:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "JP_API_BASE_URL": "https://staging-api.jainpathshala.org"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "resourceClass": "m-medium",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "latest"
      },
      "env": {
        "JP_API_BASE_URL": "https://api.jainpathshala.org",
        "SENTRY_ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "appleId": "tobedefined@jainpathshala.org",
        "ascAppId": "0000000000",
        "appleTeamId": "TEAMID"
      }
    }
  }
}
