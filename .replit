modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

# Build the whole workspace (typecheck + recursive `build`: api-server -> esbuild
# bundle at dist/index.mjs, web -> Vite build at dist/public). The web Vite config
# requires PORT + BASE_PATH even at build time, so they are provided here.
[deployment.build]
run = ["pnpm", "run", "build"]
env = { "NODE_ENV" = "production", "BASE_PATH" = "/", "PORT" = "8080" }

# Run the API server in production from its esbuild bundle (dist/index.mjs).
# See docs/DEPLOYMENT.md for the full env-var contract and how the web app is served.
[deployment.run]
run = ["pnpm", "run", "start"]
env = { "NODE_ENV" = "production", "PORT" = "8080" }

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 24588
externalPort = 80

[[ports]]
localPort = 25870
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
# JP_AUTH_SECRET must be injected via the Replit Secrets manager (never committed
# here) and rotated periodically. Set it as a Secret in the Deployment/Workspace
# Secrets pane — a strong random value (e.g. `openssl rand -base64 48`).
